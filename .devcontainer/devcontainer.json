{
    "name": "BuruCRON Development Environment",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "postCreateCommand": "npm install",
    "customizations": {
        "vscode": {
            "extensions": [
                "google.clasp",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "remoteUser": "node"
}